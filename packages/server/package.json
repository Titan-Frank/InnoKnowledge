{
  "name": "@okm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "backfill-unit-embeddings": "npm run build && node dist/cli/backfill-unit-embeddings.js",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@okm/types": "*",
    "hono": "^4.7.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
