# Local system and tool state
.DS_Store
.env
.mcp.json
.codex/
.claude/node_modules/
.claude/package.json
.claude/bun.lock
.playwright-mcp/
.playwright-cli/

# Dependencies and build outputs
node_modules/
dist/
__pycache__/
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.pdf
*.synctex.gz
*.xdv

# Generated runtime artifacts
tmp/
output/
runs/
storage/
ocr/
lesson1_*.txt

# Data: ignore local corpora by default, but keep curated configuration paths trackable
/data/*
!/data/frameworks/
!/data/patterns/
!/data/outlines/
/data/outlines/*
!/data/outlines/.gitkeep

# Experiment source, fixtures, schemas, and reports are versioned.
# Generated results and third-party runtimes stay local.
/experiments/**/outputs/*
!/experiments/**/outputs/.gitignore
/experiments/**/external/cache/
/experiments/**/external/work/

# Benchmark data derived from local textbooks stays local until rights review.
/experiments/**/data/
/experiments/**/fixtures/**/*.json
/experiments/**/fixtures/**/*.jsonl
/experiments/**/fixtures/**/*.csv

/experiments/**/*.zip
/experiments/**/*.tar
/experiments/**/*.tar.gz
/experiments/**/*.jar
/experiments/**/*.pt
/experiments/**/*.pth
/experiments/**/*.ckpt
/experiments/**/*.safetensors
/experiments/**/*.onnx
/experiments/**/*.parquet
/experiments/**/*.sqlite
/experiments/**/*.sqlite3

# Local helper tools
/tools/
