{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Textbook Mention",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "book_id",
    "anchor_ref",
    "target_type",
    "target_id",
    "role",
    "source_refs",
    "confidence",
    "properties"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^mention:[a-z0-9:-]+$"
    },
    "book_id": {
      "type": "string",
      "pattern": "^[a-z0-9:-]+$"
    },
    "anchor_ref": {
      "type": "string",
      "pattern": "^struct:[a-z0-9:-]+$"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "node",
        "edge"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z0-9:-]+$"
    },
    "role": {
      "type": "string",
      "enum": [
        "introduces",
        "focuses_on",
        "defines",
        "demonstrates",
        "applies",
        "reviews",
        "mentions",
        "supports"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^evidence:[a-z0-9:-]+$"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "properties": {
      "type": "object"
    }
  }
}
