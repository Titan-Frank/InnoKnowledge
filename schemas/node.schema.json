{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Knowledge Node",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "node_type",
    "name",
    "aliases",
    "description",
    "framework_refs",
    "properties"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9:-]+$"
    },
    "node_type": {
      "type": "string",
      "enum": [
        "concept",
        "substance",
        "experiment",
        "method",
        "skill",
        "symbol",
        "question"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "framework_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^framework:[a-z0-9:-]+$"
      }
    },
    "properties": {
      "type": "object"
    }
  }
}
