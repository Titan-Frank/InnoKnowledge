{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Knowledge Edge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "edge_type",
    "from",
    "to",
    "confidence",
    "framework_refs",
    "properties"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9:-]+$"
    },
    "edge_type": {
      "type": "string",
      "enum": [
        "contains",
        "explains",
        "uses",
        "measures",
        "produces",
        "consumes",
        "part_of",
        "prerequisite_for",
        "same_as",
        "related_to"
      ]
    },
    "from": {
      "type": "string",
      "pattern": "^[a-z0-9:-]+$"
    },
    "to": {
      "type": "string",
      "pattern": "^[a-z0-9:-]+$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "framework_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^framework:[a-z0-9:-]+$"
      }
    },
    "properties": {
      "type": "object"
    }
  }
}
