{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Node Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "title",
    "pattern_refs",
    "summary",
    "sections",
    "source_refs",
    "properties"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "pattern": "^(concept|substance|experiment|method|skill|symbol|question):[a-z0-9:-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "pattern_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^pattern:[a-z0-9:-]+$"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^evidence:[a-z0-9:-]+$"
            }
          }
        }
      }
    },
    "related_node_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9:-]+$"
      }
    },
    "framework_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^framework:[a-z0-9:-]+$"
      }
    },
    "mention_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^mention:[a-z0-9:-]+$"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^evidence:[a-z0-9:-]+$"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "validated"
      ]
    },
    "properties": {
      "type": "object"
    }
  }
}
