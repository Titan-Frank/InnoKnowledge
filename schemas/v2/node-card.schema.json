{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Node Card V2",
  "description": "Pedagogical expansion card for a canonical node.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "title",
    "summary",
    "sections",
    "properties",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^node-card:[a-z0-9:-]+$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9/_:-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "pattern_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^pattern:[a-z0-9:-]+$"
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "section_type": {
            "type": "string",
            "enum": [
              "definition",
              "essence",
              "key_points",
              "structure",
              "procedure",
              "application",
              "misconception",
              "example",
              "assessment",
              "extension",
              "evidence",
              "background",
              "comparison",
              "reflection",
              "other"
            ]
          },
          "content": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^evidence:[a-z0-9:-]+$"
            },
            "uniqueItems": true
          },
          "related_node_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9/_:-]+$"
            },
            "uniqueItems": true
          },
          "properties": {
            "type": "object"
          }
        }
      }
    },
    "framework_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^framework:[a-z0-9:-]+$"
      },
      "uniqueItems": true
    },
    "profile_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^profile:[a-z0-9:-]+$"
      },
      "uniqueItems": true
    },
    "mention_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^mention:[a-z0-9:-]+$"
      },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^evidence:[a-z0-9:-]+$"
      },
      "uniqueItems": true
    },
    "properties": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "validated"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
