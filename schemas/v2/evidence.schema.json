{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Evidence V2",
  "description": "General evidence record that supports nodes, edges, profiles, or cards.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_type",
    "source_id",
    "anchor_ref",
    "excerpt",
    "locator",
    "extraction_method",
    "properties"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evidence:[a-z0-9:-]+$"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "textbook",
        "curriculum",
        "exercise",
        "assessment",
        "note",
        "media",
        "other"
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9:-]+$"
    },
    "anchor_ref": {
      "type": "string",
      "pattern": "^[a-z0-9:-]+$"
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "page_start": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "page_end": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "excerpt": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "table",
        "equation",
        "audio",
        "video",
        "mixed"
      ]
    },
    "extraction_method": {
      "type": "string",
      "enum": [
        "manual",
        "pdftotext",
        "ocr",
        "speech_to_text",
        "mixed"
      ]
    },
    "normalized_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "properties": {
      "type": "object"
    }
  }
}
