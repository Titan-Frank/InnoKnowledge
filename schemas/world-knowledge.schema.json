{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-knowledge-map.org/schemas/world-knowledge-v1.3.json",
  "title": "World Knowledge Object Schema V1.3",
  "description": "面向多学科知识网络的统一知识对象结构。学科角色和课程位置由独立投影表示。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "kind",
    "definition",
    "domains",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9/_:-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "entity",
        "concept",
        "property",
        "process",
        "event",
        "method",
        "rule",
        "representation",
        "resource"
      ]
    },
    "subkind": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "mathematics",
          "physics",
          "chemistry",
          "biology",
          "earth-science",
          "astronomy",
          "computer-science",
          "engineering",
          "language-arts",
          "linguistics",
          "literature",
          "history",
          "geography",
          "civics",
          "economics",
          "law",
          "education",
          "arts",
          "music",
          "health",
          "sports",
          "philosophy",
          "general"
        ]
      }
    },
    "knowledge_form": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "propositional",
          "practical"
        ]
      }
    },
    "learning_mode": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "factual",
          "conceptual",
          "procedural",
          "metacognitive"
        ]
      }
    },
    "scope": {
      "type": "string",
      "enum": [
        "universal",
        "domain-specific",
        "culture-specific"
      ]
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "semantic_core": {
          "type": "object",
          "additionalProperties": true,
          "description": "Extended semantic core for the knowledge object. Keep definition short and put claims, formulas, conditions, boundaries, counterexamples, and misconceptions here.",
          "properties": {
            "core_claims": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "formal_expressions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "conditions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "boundaries": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "counterexamples": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "misconceptions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "bridge_role": {
          "type": "string",
          "enum": ["semantic_bridge", "method_bridge", "analogy_bridge"]
        }
      }
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
