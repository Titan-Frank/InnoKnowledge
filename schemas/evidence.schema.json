{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "book_id",
    "anchor_ref",
    "source_path",
    "page_start",
    "page_end",
    "snippet",
    "locator",
    "extraction_method"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evidence:[a-z0-9:-]+$"
    },
    "book_id": {
      "type": "string",
      "pattern": "^[a-z0-9:-]+$"
    },
    "anchor_ref": {
      "type": "string",
      "pattern": "^struct:[a-z0-9:-]+$"
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "page_start": {
      "type": "integer",
      "minimum": 1
    },
    "page_end": {
      "type": "integer",
      "minimum": 1
    },
    "snippet": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "extraction_method": {
      "type": "string",
      "enum": [
        "manual",
        "pdftotext",
        "ocr",
        "mixed"
      ]
    }
  }
}
