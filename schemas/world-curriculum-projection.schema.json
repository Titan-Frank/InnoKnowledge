{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-knowledge-map.org/schemas/world-curriculum-projection-v1.3.json",
  "title": "World Curriculum Projection Schema V1.3",
  "description": "知识对象在某一课程体系、学段和年级中的教学投影。教材提供教学路径，不定义知识对象身份。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "node_id", "domain", "curriculum_id", "school_stage", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9/_:-]+$" },
    "node_id": { "type": "string", "pattern": "^[a-z0-9/_:-]+$" },
    "domain": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "curriculum_id": { "type": "string", "minLength": 1 },
    "school_stage": { "type": "string", "enum": ["primary", "junior-secondary", "senior-secondary", "higher"] },
    "grade_band": { "type": ["string", "null"] },
    "curriculum_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["core", "support", "assessment", "practice", "literacy"] }
    },
    "source_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "pedagogical_profile": { "$ref": "#/$defs/pedagogicalProfile" }
      }
    },
    "status": { "type": "string", "enum": ["draft", "active", "deprecated"] },
    "notes": { "type": "string" }
  },
  "$defs": {
    "nonEmptyList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "pedagogicalProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "school_stage", "learning_objectives", "difficulty_level", "diagnostic_questions",
        "common_errors", "assessment_tasks", "remediation_suggestions", "extension_suggestions"
      ],
      "properties": {
        "school_stage": { "type": "string", "enum": ["primary", "junior-secondary", "senior-secondary", "higher"] },
        "grade_band": { "type": "string" },
        "learning_objectives": { "$ref": "#/$defs/nonEmptyList" },
        "difficulty_level": { "type": "string", "enum": ["introductory", "basic", "intermediate", "advanced", "expert"] },
        "diagnostic_questions": { "$ref": "#/$defs/nonEmptyList" },
        "common_errors": { "$ref": "#/$defs/nonEmptyList" },
        "assessment_tasks": { "$ref": "#/$defs/nonEmptyList" },
        "remediation_suggestions": { "$ref": "#/$defs/nonEmptyList" },
        "extension_suggestions": { "$ref": "#/$defs/nonEmptyList" },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generated_from"],
          "properties": {
            "generated_from": { "type": "string", "enum": ["model_generation", "manual"] },
            "model": { "type": "string" },
            "prompt_version": { "type": "string" },
            "generated_at": { "type": "string" },
            "input_fingerprint": { "type": "string" },
            "review_status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "source_refs": { "$ref": "#/$defs/nonEmptyList" }
          },
          "allOf": [{
            "if": { "properties": { "generated_from": { "const": "model_generation" } }, "required": ["generated_from"] },
            "then": { "required": ["model", "prompt_version", "generated_at", "input_fingerprint", "review_status", "confidence", "source_refs"] }
          }]
        }
      }
    }
  }
}
