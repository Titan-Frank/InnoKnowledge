{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Pattern Library",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "library_id",
    "title",
    "summary",
    "generated_at",
    "patterns"
  ],
  "properties": {
    "library_id": {
      "type": "string",
      "pattern": "^pattern-library:[a-z0-9:-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "node_type",
          "title",
          "summary",
          "sections",
          "recommended_edge_types",
          "expansion_questions",
          "properties"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^pattern:[a-z0-9:-]+$"
          },
          "node_type": {
            "type": "string",
            "enum": [
              "concept",
              "substance",
              "experiment",
              "method",
              "skill",
              "symbol",
              "question"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "required",
                "prompt"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "guidance": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "recommended_edge_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "contains",
                "explains",
                "uses",
                "measures",
                "produces",
                "consumes",
                "part_of",
                "prerequisite_for",
                "same_as",
                "related_to"
              ]
            }
          },
          "expansion_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "properties": {
            "type": "object"
          }
        }
      }
    }
  }
}
