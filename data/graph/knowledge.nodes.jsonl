{"id": "concept:metal-protection", "node_type": "concept", "name": "金属防护", "aliases": ["metal protection", "防锈"], "description": "防止金属锈蚀的方法，主要是将金属与氧气和水隔绝，如涂油漆、镀金属、保持干燥等。", "framework_refs": ["framework:cn-chem-junior:expectation:39f878be5d"], "properties": {"methods": ["涂油漆", "镀金属", "保持干燥"]}}
{"id": "concept:renewable-energy", "node_type": "concept", "name": "可再生能源", "aliases": ["renewable energy"], "description": "在自然界中可以循环再生、取之不尽的能源，包括太阳能、水能、风能等。", "framework_refs": ["framework:cn-chem-junior:expectation:7b6fe1208c"], "properties": {"examples": ["太阳能", "水能", "风能"]}}
{"id": "concept:hydrogen-energy", "node_type": "concept", "name": "氢能", "aliases": ["hydrogen energy"], "description": "氢气燃烧产生的能量，热值比化石燃料高很多，燃烧产物只有水，是清洁的绿色能源。", "framework_refs": ["framework:cn-chem-junior:expectation:7b6fe1208c"], "properties": {"advantages": ["热值高", "清洁", "可再生"]}}
{"id": "substance:ethanol", "node_type": "substance", "name": "乙醇", "aliases": ["C2H6O", "ethanol", "酒精"], "description": "俗称酒精，无色、易挥发的液体，在空气中燃烧放出大量的热，可用作燃料。", "framework_refs": ["framework:cn-chem-junior:expectation:72d428e4b4"], "properties": {"formula": "C2H6O", "state": "液体", "color": "无色"}}
{"id": "concept:nutrient", "node_type": "concept", "name": "营养素", "aliases": ["nutrient", "营养物质"], "description": "食物中能被人体消化、吸收和利用的营养成分，包括糖类、脂类、蛋白质、维生素、矿物质和水六大类。", "framework_refs": [], "properties": {"types": ["糖类", "脂类", "蛋白质", "维生素", "矿物质", "水"]}}
{"id": "concept:organic-compound", "node_type": "concept", "name": "有机化合物", "aliases": ["有机物", "organic compound"], "description": "含碳的化合物（一氧化碳、二氧化碳、碳酸钙等除外），大多数含有氢元素，有的还含有氧元素、氮元素等。", "framework_refs": [], "properties": {}}
{"id": "concept:alloy", "node_type": "concept", "name": "合金", "aliases": ["alloy"], "description": "由一种金属与其他金属或非金属熔合而成的具有金属特性的物质，往往具有比纯金属更优良的性能。", "framework_refs": ["framework:cn-chem-junior:expectation:2d9b177f5f"], "properties": {"examples": ["青铜", "黄铜", "生铁", "钢", "不锈钢"]}}
{"id": "concept:silicate-material", "node_type": "concept", "name": "硅酸盐材料", "aliases": ["silicate material", "传统无机非金属材料"], "description": "以含硅物质为原料加热制成的材料，包括陶瓷、玻璃、水泥等，具有稳定性强、硬度大、熔点高等特点。", "framework_refs": [], "properties": {"examples": ["陶瓷", "玻璃", "水泥"]}}
{"id": "concept:polymer-material", "node_type": "concept", "name": "有机高分子材料", "aliases": ["polymer material", "合成材料"], "description": "由高分子化合物制成的材料，包括塑料、合成橡胶、合成纤维等。", "framework_refs": [], "properties": {"examples": ["塑料", "合成橡胶", "合成纤维"]}}
{"id": "concept:composite-material", "node_type": "concept", "name": "复合材料", "aliases": ["composite material"], "description": "将两种或两种以上的不同材料复合起来，使各种材料在性能上取长补短制成的材料。", "framework_refs": [], "properties": {"examples": ["钢筋混凝土", "玻璃钢"]}}
{"id": "method:ph-test", "node_type": "method", "name": "pH测定方法", "aliases": ["pH试纸测定", "pH test", "酸碱度测定"], "description": "使用pH试纸测定溶液酸碱度的方法，将pH试纸置于干燥的表面皿上，用玻璃棒蘸取待测液后沾到pH试纸上，将试纸呈现的颜色与标准比色卡对比得出pH值。", "framework_refs": ["framework:cn-chem-junior:expectation:1ffee60e1e"], "properties": {}}
