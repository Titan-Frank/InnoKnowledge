{
  "id": "node-card:activity-experiment-coarse-salt-purification",
  "node_id": "activity/experiment:coarse-salt-purification",
  "card_layer": "support",
  "title": "粗盐提纯实验",
  "pattern_refs": ["pattern:activity-task-v2"],
  "summary": "粗盐提纯实验是通过溶解、过滤、蒸发三个主要步骤去除粗盐中难溶性杂质的实验，用于学习基本的化学实验操作技能。",
  "sections": [
    {
      "id": "activity-goal",
      "title": "活动目标",
      "section_type": "definition",
      "content": [
        "通过实验去除粗盐中的难溶性杂质，得到初步精制的食盐。",
        "学习并掌握溶解、过滤、蒸发等基本实验操作。",
        "这是初中化学必做实验之一。"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson:1-2-1:coarse-salt-purification"]
    },
    {
      "id": "setup",
      "title": "材料与仪器",
      "section_type": "structure",
      "content": [
        "药品：粗盐、蒸馏水",
        "仪器：烧杯、玻璃棒、量筒、胶头滴管、漏斗、滤纸、铁架台、蒸发皿、酒精灯、电子天平、称量纸"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson:1-2-1:coarse-salt-purification"]
    },
    {
      "id": "procedure",
      "title": "实施过程",
      "section_type": "procedure",
      "content": [
        "第一步-溶解：称取约5g粗盐放入烧杯中，用量筒量取约20mL蒸馏水倒入烧杯，用玻璃棒搅拌使粗盐充分溶解",
        "第二步-过滤：制作过滤器，将粗盐水沿玻璃棒倒入漏斗中过滤，得到澄清的滤液",
        "第三步-蒸发：将滤液倒入蒸发皿中加热，用玻璃棒不断搅拌，当出现较多固体时停止加热，利用余热蒸干"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson:1-2-1:coarse-salt-purification"]
    },
    {
      "id": "observations",
      "title": "关键观察与结论",
      "section_type": "evidence",
      "content": [
        "粗盐溶解后得到浑浊的溶液",
        "过滤后得到澄清透明的滤液，难溶性杂质留在滤纸上",
        "蒸发后得到白色固体（初步精制的食盐）"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson:1-2-1:coarse-salt-purification"]
    }
  ],
  "profile_refs": ["profile:activity-experiment-coarse-salt-purification-junior-chem"],
