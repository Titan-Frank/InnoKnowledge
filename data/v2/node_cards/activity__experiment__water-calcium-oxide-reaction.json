    },
    {
      "id": "procedure",
      "title": "实施过程",
      "section_type": "procedure",
      "content": [
        "在烧杯中加入少量氧化钙",
        "用滴管向烧杯中加入约1滴管水",
        "用手小心触摸烧杯外壁，感受温度变化",
        "待反应停止、冷却后，向烧杯中滴入3滴酚酞试液",
        "观察并记录实验现象"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson:3-1-1:water-calcium-oxide-reaction"]
    },
    {
      "id": "observations",
      "title": "关键观察",
      "section_type": "evidence",
      "content": [
        "现象1：水与氧化钙接触后剧烈反应",
        "现象2：烧杯外壁发烫，说明反应放出大量热",
        "现象3：滴入酚酞试液后溶液变红，说明生成了碱性物质（氢氧化钙）",
        "结论：水与氧化钙反应生成氢氧化钙，该反应是放热的化学反应"
      ],
