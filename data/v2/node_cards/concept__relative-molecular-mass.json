{
  "id": "node-card:concept__relative-molecular-mass",
  "node_id": "concept:relative-molecular-mass",
  "pattern_ref": "pattern:concept-core-v2",
  "sections": [
    {
      "id": "definition",
      "title": "定义",
      "section_type": "definition",
      "content": "相对分子质量是表示分子质量相对大小的量，等于构成分子的各个原子的相对原子质量的总和。",
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson:3-2-1:relative-molecular-mass"]
    },
    {
      "id": "essence",
      "title": "本质理解",
      "section_type": "essence",
      "content": "分子由原子结合而成，分子的质量也很小。为了使用方便，采用相对分子质量来表示分子质量的相对大小。相对分子质量与相对原子质量一样，是无单位的相对值。",
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson:3-2-1:relative-molecular-mass"]
    },
    {
      "id": "calculation",
      "title": "计算方法",
      "section_type": "procedure",
      "content": "相对分子质量 = 各原子的相对原子质量之和。例如：水(H2O)的相对分子质量 = 1×2 + 16×1 = 18；氢气(H2)的相对分子质量 = 1×2 = 2；氧气(O2)的相对分子质量 = 16×2 = 32。",
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson:3-2-1:relative-molecular-mass"]
    }
  ],
