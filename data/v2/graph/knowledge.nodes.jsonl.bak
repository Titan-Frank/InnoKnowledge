{"id":"entity/substance:iron-oxide","canonical_name":"四氧化三铁","node_kind":"entity","node_subkind":"substance","aliases":["Fe3O4","Iron oxide","磁铁矿","四氧化三铁","黑色固体"],"definition":"四氧化三铁是铁在氧气中燃烧生成的黑色固体，化学式为Fe3O4，具有磁性。","learning_modes":["factual"],"bridge_tags":["matter","change"],"properties":{"chemical_formula":"Fe3O4","state":"solid","color":"黑色","magnetism":"具有磁性"},"status":"active","created_at":"2026-03-25T16:00:00+08:00","updated_at":"2026-03-25T16:00:00+08:00"}
