{
  "node_id": "method:distillation",
  "title": "蒸馏",
  "pattern_refs": ["pattern:method-playbook"],
  "summary": "利用液体沸点不同分离混合物的方法。",
  "sections": [
    {
      "id": "purpose",
      "title": "用途",
      "content": [
        "分离沸点不同的液体混合物",
        "净化水，制备蒸馏水"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson3-1-2-core"]
    },
    {
      "id": "conditions",
      "title": "适用条件",
      "content": [
        "混合物中各组分沸点差异较大",
        "各组分不发生化学反应"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson3-1-2-core"]
    },
    {
      "id": "steps",
      "title": "操作要点",
      "content": [
        "加热混合液，使低沸点物质先蒸发",
        "蒸汽通过冷凝管冷凝成液体",
        "收集冷凝后的液体"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson3-1-2-core"]
    },
    {
      "id": "signals",
      "title": "成功标志",
      "content": [
        "得到纯净的蒸馏水",
        "硬水蒸馏后变为软水"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson3-1-2-core"]
    }
  ],
  "source_refs": ["evidence:chem-grade8-all-in-one:lesson3-1-2-core"],
