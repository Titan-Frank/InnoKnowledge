{
  "node_id": "method:combustion-method",
  "title": "燃烧法",
  "pattern_refs": ["pattern:method-playbook"],
  "summary": "利用可燃物燃烧消耗氧气导致压强变化的原理，测定密闭容器中氧气的含量。",
  "sections": [
    {
      "id": "purpose",
      "title": "用途",
      "content": [
        "用于测定密闭容器中氧气的含量"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:air-composition-2"]
    },
    {
      "id": "conditions",
      "title": "适用条件",
      "content": [
        "适用于密闭容器中的气体分析",
        "需要使用能与氧气反应的可燃物（如红磷）"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:air-composition-2"]
    },
    {
      "id": "steps",
      "title": "操作要点",
      "content": [
        "将可燃物（如红磷）放入密闭容器中燃烧",
        "等待燃烧完成，容器冷却",
        "通过测量压强变化或液体体积变化推算氧气含量"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:air-composition-2"]
    },
    {
      "id": "signals",
      "title": "成功标志",
      "content": [
        "容器内压强减小，液体被倒吸入容器",
        "进入容器的液体体积等于被消耗的氧气体积"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:air-composition-2"]
    }
  ],
  "source_refs": ["evidence:chem-grade8-all-in-one:air-composition-2"],
  "mention_refs": ["mention:chem-grade8-all-in-one:combustion-method"],
  "properties": {}
}
