  "title": "过滤",
  "pattern_refs": ["pattern:method-playbook"],
  "summary": "分离液体和不溶性固体的方法。",
  "sections": [
    {
      "id": "purpose",
      "title": "用途",
      "content": [
        "分离液体和不溶性固体",
        "净化水"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson3-1-2-core"]
    },
    {
      "id": "conditions",
      "title": "适用条件",
      "content": [
        "混合物中包含液体和不溶性固体",
        "固体颗粒较大，能被滤纸截留"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson3-1-2-core"]
    },
    {
      "id": "steps",
      "title": "操作要点",
      "content": [
        "制作过滤器：将滤纸折叠后放入漏斗",
        "润湿滤纸，使其紧贴漏斗内壁",
        "将混合物沿玻璃棒倒入过滤器",
        "收集滤液"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson3-1-2-core"]
    },
    {
      "id": "mistakes",
      "title": "常见错误",
      "content": [
        "滤纸未润湿",
        "液面高于滤纸边缘",
        "玻璃棒未靠在三层滤纸处"
      ],
      "source_refs": ["evidence:chem-grade8-all-in-one:lesson3-1-2-core"]
    }
  ],
