{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-knowledge-map.local/schemas/okm-eduku-bench/runtime-output.v0.2.json",
  "title": "OKM-EduKU-Bench v0.2 retrieval and generation output",
  "type": "object",
  "additionalProperties": true,
  "required": ["method", "status", "results"],
  "properties": {
    "method": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed", "not_run"]
    },
    "run_id": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": true,
      "required": ["case_id", "answer"],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/retrieved_unit"
          }
        },
        "retrieved_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/retrieved_evidence"
          }
        },
        "relation_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation_path"
          }
        },
        "answer": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "unsupported_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cost": {
          "$ref": "#/$defs/cost"
        }
      }
    },
    "retrieved_unit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "type": "number"
        },
        "section_id": {
          "type": "string"
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "retrieved_evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "section_id": {
          "type": "string"
        },
        "span_start": {
          "type": "integer",
          "minimum": 0
        },
        "span_end": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relation_path": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "section_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["text"],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "section_id": {
          "type": "string"
        },
        "mapped_textbook_evidence_id": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "input_tokens": {
          "type": "number",
          "minimum": 0
        },
        "output_tokens": {
          "type": "number",
          "minimum": 0
        },
        "usd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
