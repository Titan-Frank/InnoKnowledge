{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-knowledge-map.local/schemas/okm-eduku-bench/expert-score-row.v0.2.json",
  "title": "OKM-EduKU-Bench v0.2 expert score row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewer_id",
    "case_id",
    "method_code",
    "accuracy",
    "evidence_traceability",
    "stage_alignment",
    "prerequisite_coverage",
    "misconception_diagnosis",
    "diagnostic_question_quality",
    "teacher_editability",
    "preferred",
    "notes"
  ],
  "properties": {
    "reviewer_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "method_code": {
      "type": "string",
      "minLength": 1
    },
    "accuracy": {
      "$ref": "#/$defs/likert"
    },
    "evidence_traceability": {
      "$ref": "#/$defs/likert"
    },
    "stage_alignment": {
      "$ref": "#/$defs/likert"
    },
    "prerequisite_coverage": {
      "$ref": "#/$defs/likert"
    },
    "misconception_diagnosis": {
      "$ref": "#/$defs/likert"
    },
    "diagnostic_question_quality": {
      "$ref": "#/$defs/likert"
    },
    "teacher_editability": {
      "$ref": "#/$defs/likert"
    },
    "preferred": {
      "type": "string",
      "enum": ["yes", "no", ""]
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "likert": {
      "type": "string",
      "pattern": "^([1-5]|)$"
    }
  }
}
