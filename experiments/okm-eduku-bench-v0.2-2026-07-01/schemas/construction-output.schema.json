{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-knowledge-map.local/schemas/okm-eduku-bench/construction-output.v0.2.json",
  "title": "OKM-EduKU-Bench v0.2 construction output",
  "type": "object",
  "additionalProperties": true,
  "required": ["method", "status", "nodes", "edges"],
  "properties": {
    "method": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed", "not_run"]
    },
    "run_id": {
      "type": "string"
    },
    "section_id": {
      "type": "string"
    },
    "book_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_link"
      }
    },
    "semantic_core": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semantic_core"
      }
    },
    "domain_profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/domain_profile"
      }
    },
    "curriculum_projections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/curriculum_projection"
      }
    },
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_id", "target_id", "type", "type_label_zh"],
      "properties": {
        "id": {
          "type": "string"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "is_a", "instance_of", "part_of", "contains", "has_property", "uses", "produces",
            "depends_on", "prerequisite_for", "causes", "affects", "represents", "formalizes",
            "applies_to", "analogous_to", "models", "about", "related_to"
          ]
        },
        "type_label_zh": {
          "type": "string",
          "enum": [
            "是一种", "是实例", "是组成部分", "包含", "具有属性", "使用", "产生", "依赖",
            "是前置知识", "导致", "影响", "表示", "形式化表达", "应用于", "类似于", "建模描述",
            "主题是", "相关"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_link": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "target_id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "target_type": {
          "type": "string",
          "enum": ["node", "edge", "semantic_core", "domain_profile", "curriculum_projection", "pedagogical_profile", "answer_claim"]
        },
        "section_id": {
          "type": "string"
        },
        "span_start": {
          "type": "integer",
          "minimum": 0
        },
        "span_end": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semantic_core": {
      "type": "object",
      "additionalProperties": true,
      "required": ["node_id"],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string"
        },
        "core_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formulas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string"
        },
        "counterexamples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "misconceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "domain_profile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["node_id", "domain", "domain_role"],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "schema_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "domain_role": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object"
        }
      }
    },
    "curriculum_projection": {
      "type": "object",
      "additionalProperties": true,
      "required": ["node_id", "domain", "curriculum_id", "school_stage"],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "curriculum_id": {
          "type": "string",
          "minLength": 1
        },
        "school_stage": {
          "type": "string",
          "enum": ["primary", "junior-secondary", "senior-secondary", "higher"]
        },
        "grade_band": {
          "type": "string"
        },
        "curriculum_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pedagogical_profile": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "learning_objectives": {
              "type": "array",
              "items": { "type": "string" }
            },
            "difficulty_level": {
              "type": "string"
            },
            "diagnostic_questions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "common_errors": {
              "type": "array",
              "items": { "type": "string" }
            },
            "assessment_tasks": {
              "type": "array",
              "items": { "type": "string" }
            },
            "remediation_suggestions": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "input_tokens": {
          "type": "number",
          "minimum": 0
        },
        "output_tokens": {
          "type": "number",
          "minimum": 0
        },
        "usd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
