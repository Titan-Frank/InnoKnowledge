{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-knowledge-map.local/schemas/okm-eduku-bench/construction-output.v0.2.json",
  "title": "OKM-EduKU-Bench v0.2 construction output",
  "type": "object",
  "additionalProperties": true,
  "required": ["method", "status", "nodes", "edges"],
  "properties": {
    "method": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed", "not_run"]
    },
    "run_id": {
      "type": "string"
    },
    "section_id": {
      "type": "string"
    },
    "book_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_link"
      }
    },
    "semantic_core": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semantic_core"
      }
    },
    "pedagogical_profile": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pedagogical_profile"
      }
    },
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_id", "target_id", "type"],
      "properties": {
        "id": {
          "type": "string"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_link": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "target_id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "target_type": {
          "type": "string",
          "enum": ["node", "edge", "semantic_core", "pedagogical_profile", "answer_claim"]
        },
        "section_id": {
          "type": "string"
        },
        "span_start": {
          "type": "integer",
          "minimum": 0
        },
        "span_end": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semantic_core": {
      "type": "object",
      "additionalProperties": true,
      "required": ["node_id"],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string"
        },
        "core_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formulas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string"
        },
        "counterexamples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "misconceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "pedagogical_profile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["node_id"],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "learning_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "difficulty": {
          "type": "string"
        },
        "teaching_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnostic_value": {
          "type": "string"
        },
        "remediation_cues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "likely_misconceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "input_tokens": {
          "type": "number",
          "minimum": 0
        },
        "output_tokens": {
          "type": "number",
          "minimum": 0
        },
        "usd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
