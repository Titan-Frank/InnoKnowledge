# Version control
.git
.gitignore

# Runtime data (stored in PG volume, not in image)
storage/
runs/

# OCR source files (not needed for demo)
ocr/

# Python scripts and venvs (not needed for demo)
scripts/
deprecated/
.venv/
__pycache__/
*.pyc

# IDE
.idea/
.vscode/
*.swp

# Documentation (not needed at runtime)
AGENTS.md
CHANGELOG.md
CLAUDE.md
.claude/
docs/

# Build artifacts (rebuilt in Stage 1)
packages/*/dist/
packages/*/node_modules/

# Docker files themselves (keep docker/ entrypoint for COPY)
Dockerfile
docker-compose.yml
.dockerignore
